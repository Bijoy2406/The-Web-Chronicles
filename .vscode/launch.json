{
    // Native Linux launch/debug configurations for The Web Chronicles.
    //
    // Requires the Microsoft C/C++ extension (ms-vscode.cpptools) for the
    // "cppdbg" type and the "cppvsdbg"/"gdb" GDB support it bundles. GDB itself
    // is already installed on this machine (GNU gdb 17.1).
    //
    // F5 -> "Debug native Linux game (F5)": builds via the Makefile task, then
    // launches Main/TheWebChronicles under GDB with cwd = Main/ (required for
    // the game's relative asset paths) and debug symbols from -O2 (the Makefile
    // still emits full DWARF debug info by default with GCC).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug native Linux game (F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Main/TheWebChronicles",
            // The game loads all of its assets with paths relative to the
            // current working directory, so this MUST be Main/.
            "cwd": "${workspaceFolder}/Main",
            "args": [],
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build linux (make)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Run native Linux game (no debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Main/TheWebChronicles",
            "cwd": "${workspaceFolder}/Main",
            "args": [],
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build linux (make)"
        },
        {
            "name": "Debug native Linux game (attach to gdb, manual start)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Main/TheWebChronicles",
            "cwd": "${workspaceFolder}/Main",
            "args": [],
            "stopAtEntry": true,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb"
        }
    ]
}
