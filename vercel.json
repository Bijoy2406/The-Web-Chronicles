{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/game", "destination": "/web/dist/index.html" },
    { "source": "/game/", "destination": "/web/dist/index.html" }
  ],
  "headers": [
    {
      "source": "/web/dist/(.*).wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/web/dist/(.*).data",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/web/dist/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
